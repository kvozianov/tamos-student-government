# PostgreSQL connection string (Neon, Supabase, Vercel Postgres or your own server)
DATABASE_URL=postgres://user:password@localhost:5432/tamos
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public site address without a trailing slash, e.g. https://student.tamos-education.kz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# School time zone for event dates
NEXT_PUBLIC_SITE_TIMEZONE=Asia/Almaty

# Vercel Blob token for uploaded photos and documents. Leave empty to store files in ./media and ./documents
BLOB_READ_WRITE_TOKEN=

# Administrator created by `npm run create-admin` (the password is hashed, only the hash is stored)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional: protects the first-user sign-up form on an empty database: /admin/create-first-user?setup=<token>
ADMIN_SETUP_TOKEN=

# Accounts created by `npm run seed` (local or test databases only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=

# Admin account for the Playwright smoke tests (npm run test:e2e)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
