{
  "name": "tamos-student-government",
  "version": "1.0.0",
  "private": true,
  "description": "TAMOS Student Government website: news, events, programme tracker and an admin panel. Next.js + Payload CMS + PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6144\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
    "demo:clear": "tsx --env-file-if-exists=.env src/seed/clear-demo.ts",
    "typecheck": "tsc --noEmit",
    "signature": "node scripts/trace-signature.mjs && tsx --env-file-if-exists=.env src/seed/apply-signature.ts",
    "program": "tsx --env-file-if-exists=.env src/seed/program.ts",
    "leadership": "tsx --env-file-if-exists=.env src/seed/leadership.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "create-admin": "tsx --env-file-if-exists=.env src/seed/create-admin.ts",
    "team": "tsx --env-file-if-exists=.env src/seed/team.ts",
    "seed:all": "npm run seed && npm run program && npm run leadership && npm run team"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.2",
    "motion": "14.3.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "fast-uri": "^3.1.9"
  },
  "author": "Kirill Vozianov",
  "license": "MIT"
}
